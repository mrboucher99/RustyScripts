# Helper to determine if a field value is considered missing

def field_is_missing(field: str, value: Optional[str]) -> bool:
    """Return True if the given field value should be treated as missing."""
    # u_room_number is optional and never considered missing
    if field == "u_room_number":
        return False
    text = (value or "").strip()
    low = text.lower()
    if not text or low in ("none", "n/a", "undefined"):
        return True
    if field == "ip_address":
        # IPv6 addresses may contain ':' but aren't considered missing
        return False
    if ":" in text:
        return True
    if field == "u_internal_support_hours" and "x" not in low:
        return True
    if field == "owned_by" and "anthony guevara" in low:
        return True
    return False

