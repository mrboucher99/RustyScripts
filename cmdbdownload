def load_admin_manager_map(path: str) -> Dict[str, str]:
    """Return mapping of admin to manager from the given file."""
    mapping: Dict[str, str] = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or "," not in line:
                    continue
                admin, manager = line.split(",", 1)
                mapping[admin.strip()] = manager.strip()
    except Exception as e:
        dbg(f"Failed to load manager map: {e}")
    return mapping


