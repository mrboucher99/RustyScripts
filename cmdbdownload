def parse_cmdb_fields(lines: List[str]) -> Dict[str, Optional[str]]:
    """Parse key/value pairs from ``slist`` output.

    The previous implementation searched the entire text with a regex that
    assumed the next field name contained only letters and underscores.  Some
    ``slist`` fields use spaces or other characters in their labels, which
    caused values like ``host_name`` to bleed into the following label.

    This version processes the output line by line and extracts any ``key:
    value`` pairs found on the line.  It still handles multiple fields on a
    single line but no longer relies on guessing the format of the next label,
    preventing accidental inclusion of the next line's text in a value.
    """

    result = {fld: None for fld in FIELD_ORDER}
    field_pattern = re.compile(r"([A-Za-z_]+):\s*(.*?)\s*(?=\b[A-Za-z_]+:|$)", re.IGNORECASE)

    for line in lines:
        for key, val in field_pattern.findall(line):
            key_l = key.lower()
            for fld in FIELD_ORDER:
                if key_l == fld.lower():
                    result[fld] = val.strip()
                    if fld == "os_version":
                        record_os_version(val.strip())
                    break

    return result


def remove_from_input_file(path: str, host: str) -> None:
    try:
        lines = [ln.strip() for ln in open(path) if ln.strip()]
        lines = [ln for ln in lines if ln.lower() != host.lower()]
        with open(path, "w") as fh:
            fh.write("\n".join(lines) + "\n")
        base = os.path.basename(path)
        print(f"�️  Server '{host}' removed from {base}")
    except Exception:
        pause_error(f"  \u26A0\uFE0F  Could not update '{path}' for '{host}'")
        sys.exit(1)


def done_list_skip(server: str, idx: int, total: int, donelist: Set[str]) -> bool:
    """Return True and alert if server is on the done list."""
    if MARK_DONE and server in donelist:
        print(
            f"[{idx}/{total}] {server} \u2192 \u26a0\ufe0f  {server} is on the done list; skipping."
        )
        return True
    return False


