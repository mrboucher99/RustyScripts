def record_manufacturer(val: str) -> None:
    """Store manufacturer in history, keeping only the last five values."""
    v = val.strip()
    if not v:
        return
    if v in MANUFACTURER_HISTORY:
        MANUFACTURER_HISTORY.remove(v)
    MANUFACTURER_HISTORY.insert(0, v)
    if len(MANUFACTURER_HISTORY) > 5:
        MANUFACTURER_HISTORY.pop()

def _record_history(val: str, history: List[str]) -> None:
    v = val.strip()
    if not v:
        return
    if v in history:
        history.remove(v)
    history.insert(0, v)
    if len(history) > 5:
        history.pop()

def record_managed_by(val: str) -> None:
    """Store managed_by in history."""
    _record_history(val, MANAGED_BY_HISTORY)

def record_managed_by_group(val: str) -> None:
    """Store managed_by_group in history."""
