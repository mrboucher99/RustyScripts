    """Return mapping of admin to manager from the given file."""
    mapping: Dict[str, str] = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or "," not in line:
                    continue
                admin, manager = line.split(",", 1)
                mapping[admin.strip()] = manager.strip()
    except Exception as e:
