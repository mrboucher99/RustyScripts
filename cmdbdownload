def run_sseta(host: str, field: str, value: str) -> bool:
    """Run sseta and report errors with the full command."""
    real_field = SSETA_FIELD_MAP.get(field, field)
    cmd = ["sseta", "--fqdn", host, f"--{real_field}", value]
    try:
        subprocess.run(cmd, check=True, capture_output=True, text=True)
        return True
    except subprocess.CalledProcessError as e:
        err = e.stderr.strip() if e.stderr else str(e)
        pause_error(f"  \u26A0\uFE0F  sseta failed: {err}")
        print("  Command:", " ".join(cmd))
        return False


def run_ssh_command(host: str, command: str, timeout: int = 30) -> Tuple[str, bool]:
    """Execute an SSH command with notice before running."""
    if not REMOTE_MODE:
        return "", False
    dbg(f"ssh {host} {command}")
    ssh_opts = [
        "sshpass",
        "-p",
        USER_PASSWORD,
        "ssh",
        "-o",
        "StrictHostKeyChecking=no",
        "-o",
        "UserKnownHostsFile=/dev/null",
        f"{CURRENT_USER}@{host}",
        command,
    ]

    masked = "*" * len(USER_PASSWORD)
    disp_opts = ssh_opts.copy()
    if disp_opts[2]:
        disp_opts[2] = masked
    cmd_display = " ".join(disp_opts)
    print("-" * 75)
    print(f"ALERT: running SSH command: {cmd_display}")
    print("-" * 75)
    try:
        output = subprocess.check_output(ssh_opts, text=True, timeout=timeout)
        print(f"  SSH '{command}' on {host}: PASS")
        if output.strip():
            print(f"    {output.strip()}")
        return output.strip(), True
    except subprocess.CalledProcessError as e:
        msg = e.stderr.strip() if e.stderr else str(e)
        print(f"  SSH '{command}' on {host}: FAIL ({msg})")
        return "", False
    except Exception as e:
        print(f"  SSH '{command}' on {host}: FAIL ({e})")
        return "", False


def run_ssearch(
    host: str,
    length: int = 6,
    prefix: Optional[str] = None,
    domain_only: bool = False,
    append_domain: bool = True,
) -> None:
    """Run ``ssearch`` using a derived pattern."""

    if domain_only:
        domain = host.split(".", 1)[1] if "." in host else host
        pattern = domain
    else:
        if prefix is None:
            if length == 6:
                search_prefix = server_prefix(host)
            else:
                search_prefix = host[:length]
        else:
            search_prefix = prefix
        if append_domain:
            domain = host[host.find(".") :] if "." in host else ""
            pattern = f"{search_prefix}*{domain}"
        else:
            pattern = f"{search_prefix}*"

    print(f"  Running: ssearch --s {pattern} --auto")
    try:
        subprocess.run([SSEARCH_PATH, "--s", pattern, "--auto"], check=True)
    except subprocess.CalledProcessError as e:
        pause_error(f"  \u26A0\uFE0F  ssearch failed: {e}")


def update_field(host: str, fields: Dict[str, Optional[str]], fld: str, val: str, out_path: str) -> bool:
    """Update a single field via sseta and modify the slistdata file."""
    if not run_sseta(host, fld, val):
        return False
    fields[fld] = val
    if fld == "manufacturer":
        record_manufacturer(val)
    elif fld == "managed_by":
        record_managed_by(val)
    elif fld == "managed_by_group":
        record_managed_by_group(val)
    elif fld == "u_grouping":
        record_u_grouping(val)
    elif fld == "os_version":
        record_os_version(val)
    lines = open(out_path).readlines()
    with open(out_path, "w") as fh:
        written = False
        for line in lines:
            if line.lower().startswith(f"{fld.lower()}:"):
                fh.write(f"{fld}: {val}\n")
                written = True
            else:
                fh.write(line)
        if not written:
            fh.write(f"{fld}: {val}\n")
    print(f"    \u2714 {fld} set to '{val}'")
    if fld == "owned_by":
        managed = fields.get("managed_by") or ""
        ensure_admin_manager_pair(managed, val)
    if fld == "u_patch_group":
        pid_val = ""
        if val.strip().upper() == "CUSTOM":
            pid_val = "CUSTOM"
        elif "=" in val:
            pid_val = val.split("=", 1)[0].replace(" ", "")
        if pid_val:
            if run_sseta(host, PATCH_ID_FIELD, pid_val):
                fields[PATCH_ID_FIELD] = pid_val
                lines = open(out_path).readlines()
                with open(out_path, "w") as fh2:
                    pid_written = False
                    for line in lines:
                        if line.lower().startswith(f"{PATCH_ID_FIELD}:"):
                            fh2.write(f"{PATCH_ID_FIELD}: {pid_val}\n")
                            pid_written = True
                        elif line.lower().startswith(f"{fld.lower()}:"):
                            fh2.write(f"{fld}: {val}\n")
                        else:
                            fh2.write(line)
                    if not pid_written:
                        fh2.write(f"{PATCH_ID_FIELD}: {pid_val}\n")
                print(f"    \u2714 {PATCH_ID_FIELD} set to '{pid_val}'")
    return True


def manual_menu(host: str, fields: Dict[str, Optional[str]], out_path: str) -> Tuple[Dict[str, Optional[str]], bool]:
    """Manual field entry submenu."""
    changed = False
    while True:
        print("\nManual field entry:")
        for i, fld in enumerate(FIELD_ORDER, 1):
            val = fields.get(fld) or "<BLANK>"
            if fld == "ip_address" and val != "<BLANK>":
                val = extract_ipv4(val)
            print(f"  {i}) {fld} [{val}]")
        print("  0) return\n")
        sel = input("Select field number: ").strip()
        if sel in ("", "0"):
            break
        if not sel.isdigit() or not (1 <= int(sel) <= len(FIELD_ORDER)):
            print("  \u26A0\uFE0F  Invalid selection.")
            continue
        fld = FIELD_ORDER[int(sel) - 1]
        val = input(f"Enter value for {fld}: ").strip()
        if val:
            if update_field(host, fields, fld, val, out_path):
                changed = True
    return fields, changed


def pre_slist_owner_fix(host: str, out_path: str) -> None:
    """Clear 'owned_by' field if it contains Anthony Guevara before slist."""
    if not os.path.isfile(out_path):
        return
    lines = open(out_path).read().splitlines()
    fields = parse_cmdb_fields(lines)
    owned_val = (fields.get("owned_by") or "").lower()
    if "anthony guevara" in owned_val:
        if run_sseta(host, "owned_by", ""):
            new_lines = []
            written = False
            for line in lines:
                if line.lower().startswith("owned_by:"):
                    new_lines.append("owned_by:")
                    written = True
                else:
                    new_lines.append(line)
            if not written:
                new_lines.append("owned_by:")
            with open(out_path, "w") as fh:
                fh.write("\n".join(new_lines))
            dbg("Cleared owned_by containing Anthony Guevara before slist")



