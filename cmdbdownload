def read_lines_from_file(path: str) -> Set[str]:
    try:
        return {ln.strip() for ln in open(path) if ln.strip()}
    except Exception:
        return set()


def deduplicate_hosts(hosts: List[str]) -> List[str]:
    """Return host list without case-insensitive duplicates."""
    deduped = []
    seen = set()
    for h in hosts:
        k = h.lower()
        if k not in seen:
            deduped.append(h)
            seen.add(k)
    return deduped


def deduplicate_file(path: str) -> None:
    """Remove duplicate lines from a file, preserving order."""
    if not os.path.isfile(path):
        return
    lines = [ln.strip() for ln in open(path) if ln.strip()]
    deduped = deduplicate_hosts(lines)
    if len(deduped) != len(lines):
        with open(path, "w") as fh:
            fh.write("\n".join(deduped) + "\n")
        print(f"Removed {len(lines) - len(deduped)} duplicate host(s) from {path}")

def alert_no_pause(triggered: bool, reason: str) -> None:
