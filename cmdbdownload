                alert_no_pause(pause_triggered, pause_reason)
                print("\n" + "-"*100)
                servers.pop(idx-1)
                continue
            if server.startswith("atl") and server.endswith(".pace.gatech.edu"):
                print(f"[{idx}/{len(servers)}] {server} \u2192 SKIPPED (atl*.pace.gatech.edu)")
                skipped_total += 1
                pause_reason = "atl pace pattern"
                alert_no_pause(pause_triggered, pause_reason)
                print("\n" + "-"*100)
                servers.pop(idx-1)
                continue
        out_path = os.path.join(vault_dir, f"{server}.txt")
        if os.path.isfile(out_path) and not FORCE_OVERWRITE:
            print(f"[{idx}/{len(servers)}] {server} \u2192 OUTPUT EXISTS, skipping")
            skipped_total += 1
            pause_reason = "output exists"
            alert_no_pause(pause_triggered, pause_reason)
            print("\n" + "-"*100)
            idx += 1
            continue
        elif os.path.isfile(out_path):
            print(f"[{idx}/{len(servers)}] {server} \u2192 OUTPUT EXISTS but overwrite enabled, updating")

        pg_str = " ".join(
            f"{k}:{PATCH_GROUP_TOTALS[k]}" for k in sorted(PATCH_GROUP_TOTALS)
        )
        line = (
            f"[{idx}/{len(servers)}] {server} | Success: {uptodate_total} | "
            f"Failures: {notuptodate_total} | Missing Log: {running_missing_total} | "
            f"Port 22 Timeouts: {port_timeouts_total} | Room#0: {room_zero_total} | "
            f"Patch Groups: {pg_str}"
        )
        if CDSPLIT:
            line += f" | C Count: {patch_c_total} | D Count: {patch_d_total}"
        print(line)


        env = os.environ.copy()
        env.update({
            "CMDB_VMWARE": "1" if VMWARE_MODE else "0",
            "CMDB_FORCE": "1" if FORCE_OVERWRITE else "0",
            "CMDB_REMOTE": "1" if REMOTE_MODE else "0",
            "CMDB_PASS": USER_PASSWORD,
            "CMDB_VERBOSE": "1" if VERBOSE else "0",
            "CMDB_APIFIX": "1" if APIFIX else "0",
        })
        print(f"---> about to run cmdb-presteps for {server}")
        proc = subprocess.run([
            os.path.join(os.path.dirname(__file__), "cmdb-presteps"),
            server,
        ], env=env)
        if proc.returncode == 3:
            print(f"  \u26a0\ufe0f  {server} has ARP age over 90 days; removing from list")
            remove_from_input_file(input_file, server)
            skipped_total += 1
            print("\n" + "-" * 100)
            servers.pop(idx-1)
            continue
        if proc.returncode != 0:
            pause_error(f"  \u26A0\ufe0f  cmdb-presteps failed for {server}: code {proc.returncode}")
            failure_total += 1
            if server not in seen_failures:
                open(fail_file, "a").write(f"{server}\n")
                seen_failures.add(server)
            if FORCE_PAUSE_MENU and is_port_22_open(server):
                input("Press ENTER to continue… ")
                pause_triggered = True
            print("\n" + "-" * 100)
            idx += 1
            continue
        if os.path.isfile(out_path):
            lines = open(out_path).read().splitlines()
        else:
            lines = []
        fields = parse_cmdb_fields(lines)
        missing_fields = [
            f
            for f, v in fields.items()
            if field_is_missing(f, v)
        ]
        opstat = (fields.get("operational_status") or "").strip().lower()
        skip_missing_pause = opstat in ("retired", "inactive")
        in_missing_file = False
        try:
            lines = [ln.strip().lower() for ln in open(MISSING_APIFIX_FILE)]
            if server.lower() in lines:
                in_missing_file = True
        except Exception:
            pass
        if in_missing_file:
            skip_missing_pause = True
        if AUTO_RUN_SSETA and missing_fields and not repeated:
            run_ssearch(server, 5)
            if os.path.isfile(out_path):
                try:
                    os.remove(out_path)
                except OSError:
                    pass
            auto_repeat_set.add(server)
            continue
        if FORCE_PAUSE_MENU and missing_fields and not skip_missing_pause:
            print("  ─ Parsed CMDB Fields ─")
            for fld in FIELD_ORDER:
                val = fields[fld] or '<BLANK>'
                if fld == 'ip_address' and val != '<BLANK>':
                    val = extract_ipv4(val)
                if fld == 'u_patch_group' and val != '<BLANK>' and '=' in val:
                    prefix = val.split('=', 1)[0].strip()
                    val = f"{val} ({prefix})"
                if fld == 'u_room_number' and val == '<BLANK>':
                    continue
                print(f"    {fld:<20}\t{val}")
            fields, repeat_req, changed = fix_menu(server, fields, out_path)
            pause_triggered = True
            if repeat_req:
                continue
            if MARK_DONE and not changed and server not in donelist_set:
                open(donelist_file, "a").write(f"{server}\n")
                donelist_set.add(server)
                print(f"  \u2139\ufe0f  Added '{server}' to donelist.txt")
        else:
            if FULL_PAUSE and missing_fields and not skip_missing_pause:
                fields, repeat_req, changed = fix_menu(server, fields, out_path)
                pause_triggered = True
                if repeat_req:
                    continue
                if MARK_DONE and not changed and server not in donelist_set:
                    open(donelist_file, "a").write(f"{server}\n")
                    donelist_set.add(server)
                    print(f"  \u2139\ufe0f  Added '{server}' to donelist.txt")
            elif FIX_INTERACTIVE and missing_fields and not skip_missing_pause:
                fields, repeat_req, changed = fix_menu(server, fields, out_path)
                pause_triggered = True
                if repeat_req:
                    continue
                if MARK_DONE and not changed and server not in donelist_set:
                    open(donelist_file, "a").write(f"{server}\n")
                    donelist_set.add(server)
                    print(f"  \u2139\ufe0f  Added '{server}' to donelist.txt")
            elif PAUSE_ON_BLANK and missing_fields and not skip_missing_pause:
                msg = f"{server}: {len(missing_fields)} field(s) blank/None/n/a/undefined."
                input(msg + " Press ENTER to continue… ")

        print("  ─ Parsed CMDB Fields ─")
        for fld in FIELD_ORDER:
            val = fields[fld] or '<BLANK>'
            if fld == 'ip_address' and val != '<BLANK>':
                val = extract_ipv4(val)
            if fld == 'u_patch_group' and val != '<BLANK>' and '=' in val:
                prefix = val.split('=', 1)[0].strip()
                val = f"{val} ({prefix})"
            if fld == 'u_room_number' and val == '<BLANK>':
                continue
            print(f"    {fld:<20}\t{val}")
        final_missing = [
            f
            for f, v in fields.items()
            if field_is_missing(f, v)
        ]
        if not final_missing:
            uptodate_total += 1
            print(f"  \u2705 All fields are up to date ({uptodate_total})")
        else:
            notuptodate_total += 1
            total = len(FIELD_ORDER)
            print(f"  Fields: {total-len(final_missing)}/{total} | Total Missing: {len(final_missing)}")
            running_missing_total += len(final_missing)
        if FORCE_PAUSE_MENU and not pause_triggered:
            if skip_missing_pause and final_missing:
                if in_missing_file:
                    pause_reason = "listed in cmdb-missingrecords.txt"
                else:
                    pause_reason = f"operational_status {fields.get('operational_status', '')}"
            elif not final_missing:
                pause_reason = "no missing fields"
            else:
                pause_reason = "--auto active" if AUTO_RUN_SSETA else "other logic"
            alert_no_pause(pause_triggered, pause_reason)

        ping_ok_after = is_pingable(server)
        print(f"  Ping After Presteps: {'pass' if ping_ok_after else 'fail'}")
        if not ping_ok_after:
            print(f"  \u26a0\ufe0f  {server} not pingable; removing from list")
            skipped_total += 1
            pause_reason = "unpingable host"
            alert_no_pause(pause_triggered, pause_reason)
            remove_from_input_file(input_file, server)
            print("\n" + "-"*100)
            time.sleep(1)
            servers.pop(idx-1)
            continue

        if (fields.get("u_room_number") or "").strip() == "0":
            room_zero_total += 1

        pid_val = (fields.get(PATCH_ID_FIELD) or "").strip().upper()

        if pid_val.startswith("CUSTOM"):
            PATCH_GROUP_TOTALS["CUSTOM"] += 1
        elif pid_val and pid_val[0] in PATCH_GROUP_TOTALS:
            PATCH_GROUP_TOTALS[pid_val[0]] += 1
        else:
            pgrp = (fields.get("u_patch_group") or "").strip().upper()
            if pgrp.startswith("CUSTOM"):
                PATCH_GROUP_TOTALS["CUSTOM"] += 1
            elif pgrp and pgrp[0] in PATCH_GROUP_TOTALS:
                PATCH_GROUP_TOTALS[pgrp[0]] += 1

        if CDSPLIT:
            if pid_val == "C":
                patch_c_total += 1
            elif pid_val == "D":
                patch_d_total += 1
            if patch_c_total and patch_d_total:
                if patch_c_total >= patch_d_total * 1.4 or patch_d_total >= patch_c_total * 1.4:
                    input(f"--cdsplit pause: C={patch_c_total} D={patch_d_total}. Press ENTER to continue… ")

        print("\n" + "-"*100)
        auto_repeat_set.discard(server)
        success_total += 1
        idx += 1

    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    summary = (
        f"{ts} | Success: {success_total} | Failures: {failure_total} | "
        f"Skipped: {skipped_total} | Missing Fields Logged: {running_missing_total} | "
        f"Up-to-date: {uptodate_total} | Port 22 Timeouts: {port_timeouts_total} | "
        f"Room#0: {room_zero_total} | "
        f"Patch Groups: " + ", ".join(f"{k}:{PATCH_GROUP_TOTALS[k]}" for k in sorted(PATCH_GROUP_TOTALS)) + "\n"
    )
    open(history_file, "a").write(summary)

    print("\n" + "="*100)
    print("� cmdb-history.txt contents:")
    print("="*100)
    print(open(history_file).read().strip())
    print("="*100 + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())

