def ensure_admin_manager_pair(managed_by: str, owned_by: str) -> None:
    """Ensure the admin-manager list contains the given mapping."""
    m = managed_by.strip()
    o = owned_by.strip()
    if not m or not o:
        return
    pair_line = f"{m},{o}"
    # quick check in loaded map
    if ADMIN_MANAGER_MAP.get(m, "").lower() == o.lower():
        return
    try:
        lines = [ln.strip() for ln in open(ADMIN_MANAGER_FILE)]
    except Exception:
        lines = []
    if any(pair_line.lower() == ln.lower() for ln in lines):
        return
    try:
        with open(ADMIN_MANAGER_FILE, "a") as fh:
            fh.write(pair_line + "\n")
        ADMIN_MANAGER_MAP[m] = o
        dbg(f"Added '{pair_line}' to admin-manager list")
    except Exception as e:
        dbg(f"Failed to update admin-manager file: {e}")

