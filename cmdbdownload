def pre_display_checks(
    host: str, fields: Dict[str, Optional[str]], out_path: str, port_22_ok: bool
) -> Tuple[Dict[str, Optional[str]], List[str]]:
    updates: List[str] = []
    # Blank owned_by if it still contains the outdated value
    owned_val = (fields.get("owned_by") or "").lower()
    if "anthony guevara" in owned_val:
        if run_sseta(host, "owned_by", ""):
            updates.append("owned_by")
            fields["owned_by"] = ""
            lines = open(out_path).readlines()
            written = False
            with open(out_path, "w") as fh:
                for line in lines:
                    if line.lower().startswith("owned_by:"):
                        fh.write("owned_by:\n")
                        written = True
                    else:
                        fh.write(line)
                if not written:
                    fh.write("owned_by:\n")
            dbg("Cleared owned_by containing Anthony Guevara after slist")

    # Auto-fill host_name using the prefix of the server name when missing
    if field_is_missing("host_name", fields.get("host_name")):
        remote_name = host.split(".")[0]
        print(f"  Running command: sseta --fqdn {host} --host_name {remote_name}")
        if run_sseta(host, "host_name", remote_name):
            updates.append("host_name")
            fields["host_name"] = remote_name
            lines = open(out_path).readlines()
            written = False
            with open(out_path, "w") as fh:
                for line in lines:
                    if line.lower().startswith("host_name:"):
                        fh.write(f"host_name: {remote_name}\n")
                        written = True
                    else:
                        fh.write(line)
                if not written:
                    fh.write(f"host_name: {remote_name}\n")
        dbg(f"Auto-filled host_name with '{remote_name}'")
    # Autopopulate u_patch_indentifier from u_patch_group when possible
    pid = (fields.get(PATCH_ID_FIELD) or "").strip()
    pgrp = (fields.get("u_patch_group") or "").strip()
    auto_pid = ""
    prefix = ""
    if pgrp:
        if "=" in pgrp:
            prefix = pgrp.split("=", 1)[0].replace(" ", "")
        elif pgrp.strip().upper() == "CUSTOM":
            prefix = "CUSTOM"
    if not pid and prefix:
        auto_pid = prefix
    elif FORCE_OVERWRITE and prefix and prefix != pid:
        auto_pid = prefix
    if auto_pid:
        if run_sseta(host, PATCH_ID_FIELD, auto_pid):
            updates.append(PATCH_ID_FIELD)
            fields[PATCH_ID_FIELD] = auto_pid
            lines = open(out_path).readlines()
            written = False
            with open(out_path, "w") as fh:
                for line in lines:
                    if line.lower().startswith(f"{PATCH_ID_FIELD}:"):
                        fh.write(f"{PATCH_ID_FIELD}: {auto_pid}\n")
                        written = True
                    else:
                        fh.write(line)
                if not written:
                    fh.write(f"{PATCH_ID_FIELD}: {auto_pid}\n")
            dbg(f"Auto-filled {PATCH_ID_FIELD} with '{auto_pid}'")

    desired_inv = f"vm-{host.replace('.gatech.edu', '')}"
    if fields.get("u_gt_inventory") != desired_inv:
        if run_sseta(host, "u_gt_inventory", desired_inv):
            updates.append("u_gt_inventory")
            fields["u_gt_inventory"] = desired_inv
            lines = open(out_path).readlines()
            written = False
            with open(out_path, "w") as fh:
                for line in lines:
                    if line.lower().startswith("u_gt_inventory:"):
                        fh.write(f"u_gt_inventory: {desired_inv}\n")
                        written = True
                    else:
                        fh.write(line)
                if not written:
                    fh.write(f"u_gt_inventory: {desired_inv}\n")
            dbg(f"Set u_gt_inventory to '{desired_inv}'")

    if VMWARE_MODE:
        manufacturer = "VMware, Inc."
        if fields.get("manufacturer") != manufacturer:
            if run_sseta(host, "manufacturer", manufacturer):
                record_manufacturer(manufacturer)
                updates.append("manufacturer")
                fields["manufacturer"] = manufacturer
                lines = open(out_path).readlines()
                written = False
                with open(out_path, "w") as fh:
                    for line in lines:
                        if line.lower().startswith("manufacturer:"):
                            fh.write(f"manufacturer: {manufacturer}\n")
                            written = True
                        else:
                            fh.write(line)
                    if not written:
                        fh.write(f"manufacturer: {manufacturer}\n")
                dbg(f"Set manufacturer to '{manufacturer}' via --vmware")

        sla_val = fields.get("u_sla_type") or ""
        if "physical-" in sla_val.lower():
            new_sla = re.sub("(?i)physical-", "vm-", sla_val)
            if run_sseta(host, "u_sla_type", new_sla):
                updates.append("u_sla_type")
                fields["u_sla_type"] = new_sla
                lines = open(out_path).readlines()
                written = False
                with open(out_path, "w") as fh:
                    for line in lines:
                        if line.lower().startswith("u_sla_type:"):
                            fh.write(f"u_sla_type: {new_sla}\n")
                            written = True
                        else:
                            fh.write(line)
                    if not written:
                        fh.write(f"u_sla_type: {new_sla}\n")
                dbg(f"Updated u_sla_type to '{new_sla}' via --vmware")

        desired_cat = "vmware"
        if fields.get("category") != desired_cat:
            if run_sseta(host, "category", desired_cat):
                updates.append("category")
                fields["category"] = desired_cat
                lines = open(out_path).readlines()
                written = False
                with open(out_path, "w") as fh:
                    for line in lines:
                        if line.lower().startswith("category:"):
                            fh.write(f"category: {desired_cat}\n")
                            written = True
                        else:
                            fh.write(line)
                    if not written:
                        fh.write(f"category: {desired_cat}\n")
                dbg(f"Set category to '{desired_cat}' via --vmware")

        virt_field = "virtual"
        virt_val = fields.get(virt_field) or ""
        if not virt_val.strip():
            if run_sseta(host, virt_field, "true"):
                updates.append(virt_field)
                fields[virt_field] = "true"
                lines = open(out_path).readlines()
                written = False
                with open(out_path, "w") as fh:
                    for line in lines:
                        if line.lower().startswith(f"{virt_field.lower()}:"):
                            fh.write(f"{virt_field}: true\n")
                            written = True
                        else:
                            fh.write(line)
                    if not written:
                        fh.write(f"{virt_field}: true\n")
                dbg(f"Set {virt_field} to 'true' via --vmware")

    inv_val = fields.get("u_gt_inventory") or ""
    if ".sw.gatech.edu" in host and "vm-" in inv_val.lower():
        new_inv = "Network Device"
        if run_sseta(host, "u_gt_inventory", new_inv):
            updates.append("u_gt_inventory")
            fields["u_gt_inventory"] = new_inv
            lines = open(out_path).readlines()
            written = False
            with open(out_path, "w") as fh:
                for line in lines:
                    if line.lower().startswith("u_gt_inventory:"):
                        fh.write(f"u_gt_inventory: {new_inv}\n")
                        written = True
                    else:
                        fh.write(line)
                if not written:
                    fh.write(f"u_gt_inventory: {new_inv}\n")
            dbg(f"Set u_gt_inventory to '{new_inv}' for network device")

