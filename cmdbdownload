def fix_menu(host: str, fields: Dict[str, Optional[str]], out_path: str) -> Tuple[Dict[str, Optional[str]], bool, bool]:
    """Interactive menu for fixing blank fields.

    Returns a tuple of the updated fields, a boolean indicating if the caller
    should restart processing for this host, and a boolean showing if any field
    was changed by the user.
    """
    global FORCE_PAUSE_MENU
    changed = False
    while True:
        loop_changed = False
        missing = [
            f
            for f, v in fields.items()
            if field_is_missing(f, v)
        ]
        if not missing:
            print("�  All fields now populated.")
            if FORCE_PAUSE_MENU or PAUSE_ON_BLANK:
                print()
                time.sleep(2)
            break
        print("\n�  Missing fields:")
        for i, fld in enumerate(missing, 1):
            notes = []
            if fld in SUBMENU_FIELDS:
                notes.append("submenu")
            if fld in PRESTEP_FIELDS:
                notes.append("prestep")
            note_text = f" ({', '.join(notes)})" if notes else ""
            print(f"  {i}) {fld}{note_text}")
        print("  r) repeat checks")
        print("  s) ssearch on prefix*domain (first 6)")
        print("  t) ssearch on prefix*domain (first 5)")
        print("  -) ssearch on text-before-dash*domain")
        if "ad.gatech.edu" not in host:
            print("  d) ssearch on domain")
