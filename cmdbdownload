# Helper to compute the server prefix (first six characters,
# minus a trailing digit if present)

def server_prefix(host: str) -> str:
    """Return the server prefix used for searches."""
    prefix = host[:6]
    if prefix and prefix[-1].isdigit():
        prefix = prefix[:-1]
    return prefix

# Helper to get text before the first dash in the hostname

def server_predash(host: str) -> str:
    """Return substring before the first '-' in the host."""
    if '-' in host:
        return host.split('-', 1)[0]
    return host.split('.', 1)[0] if '.' in host else host

# Helper to remove digits from the hostname prefix before the first dot

def server_nodigits(host: str) -> str:
    """Return the hostname segment before '.' with digits removed."""
    prefix = host.split('.', 1)[0]
    return re.sub(r"\d", "", prefix)

# Extract and return the IPv4 portion of an ip_address value
def extract_ipv4(ip_val: str) -> str:
    """Return the IPv4 address when both IPv6 and IPv4 are present."""
    if ":" in ip_val:
        m = re.search(r"(\b(?:\d{1,3}\.){3}\d{1,3}\b)", ip_val)
        if m:
            return m.group(1)
    return ip_val

